# Copy to .env and fill in real values. NEVER commit .env.
# Spring Boot reads these via ${ENV_VAR} placeholders in application.yml.

# Database
DB_URL=jdbc:postgresql://localhost:5432/lms-project
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Server
SERVER_PORT=8081

# JWT  (HS256 needs a base64-encoded 256-bit key. Generate with:
#   openssl rand -base64 32   →   then base64-encode result if not already)
JWT_SECRET=replace-with-a-fresh-base64-256bit-key
JWT_EXPIRATION_MS=604800000
